# Fail-closed localhost origin policy (defaults).
# For local Vite: copy to `.env` or `.env.development.local` (gitignored) and set:
#   VITE_ALLOW_LOCALHOST_ORIGINS=true
# Production / preview builds never allow loopback (`import.meta.env.DEV` is false).

APP_ENV=production
PANEL_ALLOW_LOCALHOST=false
VITE_ALLOW_LOCALHOST_ORIGINS=false
# Identity tenant for email verification resend / code (defaults to fonitas).
# VITE_IDENTITY_TENANT_SLUG=fonitas
# DEV uses Vite proxy /fonitas-api → api.fonitas.com. Override if needed:
# VITE_IDENTITY_API=/fonitas-api/api/v1
# VITE_IDENTITY_PROXY_TARGET=https://api.fonitas.com
