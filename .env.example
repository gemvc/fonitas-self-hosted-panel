# Fail-closed localhost origin policy (defaults).
# For local Vite: copy to `.env` or `.env.development.local` (gitignored) and set:
#   VITE_ALLOW_LOCALHOST_ORIGINS=true
# Production / preview builds never allow loopback (`import.meta.env.DEV` is false).

APP_ENV=production
PANEL_ALLOW_LOCALHOST=false
VITE_ALLOW_LOCALHOST_ORIGINS=false
# Application Identity realm (optional local override). Production resolves via
# GET /developer-panels/oem/identity-tenant from the installation Origin.
# Do not use tenant `fonitas` for OEM buyers — that is the marketplace console realm.
# VITE_IDENTITY_TENANT_SLUG=acme-app
# DEV uses Vite proxy /fonitas-api → api.fonitas.com. Override if needed:
# VITE_IDENTITY_API=/fonitas-api/api/v1
# VITE_CUSTOMER_API=/fonitas-api/api/v1
# VITE_IDENTITY_PROXY_TARGET=https://api.fonitas.com
# Optional local override for OEM application filtering (otherwise /api/bound-application):
# VITE_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# Optional Help space for profile deep links:
# VITE_HELP_SPACE_SLUG=docs
# OEM production builds set VITE_OEM_SAME_ORIGIN_API via vite.oem.config.ts.
