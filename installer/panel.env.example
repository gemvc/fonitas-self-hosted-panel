# Copy to the document root as `.env` next to setup.php.
# Protect it: setup.php writes a deny rule into .htaccess when possible.
# Do not commit real secrets.

# Required: login for /setup.php and the dashboard (no cPanel Directory Privacy).
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-me-to-16-plus-chars

# Required for first install / reconnect (from Custom Domains → Show connection key).
# Clear or rotate after a successful install.
PANEL_CONNECTION_KEY=

# Optional. Defaults to the HTTPS Host of the request.
# PANEL_ORIGIN=https://dashboard.example.com

# Optional branding used by “Install latest dashboard from .env”
PANEL_BRAND_NAME=Dashboard
PANEL_LANGUAGE=en
PANEL_ACCENT=#2858b8
PANEL_SUPPORT_URL=

# Fail-closed localhost only for local development.
APP_ENV=production
PANEL_ALLOW_LOCALHOST=false
