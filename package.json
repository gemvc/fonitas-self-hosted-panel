{
  "name": "fonitas-self-hosted-panel",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:oem": "npm run typecheck && vite build --config vite.oem.config.ts",
    "preview": "vite preview",
    "docker:dev": "docker compose up panel",
    "docker:preview": "docker compose --profile preview up --build preview",
    "docker:customer": "docker compose --profile customer up customer",
    "docker:down": "docker compose --profile customer --profile preview down"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
